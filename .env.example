# Backend: memory (demo fixtures, default) or postgres
LOBBY_BACKEND=memory
# Local Postgres, or Supabase: Project Settings > Database > Connection string (Session pooler)
LOBBY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p4_lobby
LOBBY_TIMEZONE=America/Sao_Paulo

# stdio identity (local server): which condominium and role this process acts as
LOBBY_CONDOMINIUM_ID=11111111-1111-4111-8111-111111111111
LOBBY_ROLE=viewer

# Remote server
LOBBY_HOST=127.0.0.1
LOBBY_PORT=8000
# LOBBY_PUBLIC_URL=https://lobbyeasy-mcp.fly.dev
# LOBBY_API_KEYS_FILE=api_keys.json     # or LOBBY_KEY_STORE=postgres (table mcp_api_keys)
LOBBY_STATELESS_HTTP=true

# Safety
LOBBY_ENABLE_WRITES=false              # write tools are not even registered unless true
LOBBY_CONFIRMATION_TTL_SECONDS=300
LOBBY_RATE_LIMIT_CAPACITY=30           # burst per API key
LOBBY_RATE_LIMIT_REFILL_PER_SECOND=0.5 # sustained calls/second per key
