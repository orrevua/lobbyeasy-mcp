# Backend: memory (demo fixtures, default) or postgres
LOBBY_BACKEND=memory
# Local Postgres, or Supabase: Project Settings > Database > Connection string (Session pooler)
LOBBY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p4_lobby
LOBBY_TIMEZONE=America/Sao_Paulo

# stdio identity (local server): which condominium and role this process acts as
LOBBY_CONDOMINIUM_ID=11111111-1111-4111-8111-111111111111
LOBBY_ROLE=viewer
